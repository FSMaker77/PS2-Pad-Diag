<?xml version="1.0" encoding="UTF-8"?>
<!-- MKPS2ISO project: TEST DIAG (DualShock 2 controller tester) -->
<iso_project image_name="ps2pad-diag-usa.iso" region="usa">

	<layer>
		<directory_tree source=".">

			<!-- Boot configuration: BOOT2 points to the ELF below. -->
			<file name="system.cnf" source="SYSTEM-USA.CNF"/>

			<!-- Main executable. -->
			<file name="ps2pad-diag.elf" source="ps2pad-diag.elf"/>

			<!-- IOP modules needed by libpad, so the disc is self-contained. -->
			<file name="sio2man.irx" source="sio2man.irx"/>
			<file name="padman.irx" source="padman.irx"/>

			<!-- Audio modules for the UI click. -->
			<file name="libsd.irx" source="libsd.irx"/>
			<file name="audsrv.irx" source="audsrv.irx"/>

			<!-- Padding to keep the drive from hunting. -->
			<dummy sectors="512"/>

		</directory_tree>
	</layer>

</iso_project>
